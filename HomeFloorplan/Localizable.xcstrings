    "smartlighting.edit.scenes.footer" : {
      "comment" : "A footer for the \"Scene per Phase\" section of the lighting profile edit view.",
      "extractionState" : "extracted_with_value",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\"None\" skips that phase — the engine makes no change. Only custom HomeKit scenes are listed. Times are based on today's sunrise/sunset."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Nessuna\" salta quella fase: il motore non modifica le luci. Sono elencate solo le scene HomeKit personalizzate. Gli orari si basano su alba e tramonto di oggi."
          }
        }
      }
    },
    "smartlighting.edit.scenes.header" : {
      "comment" : "A heading for the list of scenes that can be selected for each lighting phase.",
