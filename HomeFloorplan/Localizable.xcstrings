      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Set when Evening becomes Night. The silence window prevents automatic scene activation while you want manual control."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposta quando Sera diventa Notte. La finestra di silenzio evita attivazioni automatiche quando vuoi controllo manuale."
